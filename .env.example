# Copy to .env beside docker-compose.yml and fill in. .env is gitignored.

# Shared secret between the service and the userscript.
# OPTIONAL. Leave it blank and one is generated on first boot and saved to the
# database; the userscript you install from the status page already carries it.
# Set it only to pin a specific value — an explicit token always wins.
#   Generate one yourself with:  openssl rand -hex 32
IDLARR_TOKEN=

# --- notifications -------------------------------------------------------
# Every alert goes through Apprise, so one setting covers every service.
# Comma-separated. Full URL formats: https://github.com/caronc/apprise/wiki
#
#   ntfy.sh            ntfy://ntfy.sh/your-topic
#   self-hosted ntfy   ntfys://ntfy.example.com/your-topic?token=tk_xxx
#   Pushover           pover://USER_KEY@APP_TOKEN
#   Pushbullet         pbul://ACCESS_TOKEN
#   Discord            discord://WEBHOOK_ID/WEBHOOK_TOKEN
#   Telegram           tgram://BOT_TOKEN/CHAT_ID
#   Gotify             gotify://HOST/TOKEN
#
# Technically optional -- the service boots and warns -- but with this empty
# nothing can ever reach you, which is the failure this project exists to
# prevent. These strings contain credentials; that is why they live in .env.
IDLARR_NOTIFY_URLS=

# Public URL of the status page — where the userscript reports, and the link
# in every alert. SEEDS the config on first run; after that it is set in
# Settings -> General and this variable is ignored. Safe to leave blank.
STATUS_URL=

# Local timezone. SEEDS the config on first run; after that the timezone in
# trackers.yml is authoritative and this variable is ignored. Set it before
# your first start, or fix it in Settings -> General afterwards — day counting
# is calendar days in that zone, so a wrong one shifts every countdown.
TZ=UTC

# NOTE: there is no PUID setting here, and that is deliberate. The UID is baked
# into the image at build time, so setting it at runtime does nothing. The
# published image runs as 1001 -- chown your data/ and config/ to match:
#     mkdir -p data config && chown -R 1001 data config
# To use a different UID, build from source:
#     docker compose build --build-arg PUID=1000

# --- signing in ----------------------------------------------------------
# There is deliberately no password setting here. The UI login is configured
# from the status page and stored HASHED in the database, the way the *arrs do
# it -- so you can change it without editing a file or recreating a container.
# It is optional; with none set, anyone who can reach the port can read your
# tracker list, reset a countdown, and rewrite your limits. That is fine behind
# Tailscale or a VPN and a bad idea on a shared LAN.
#
# Forgot the password? There is no config file to hand-edit, so set this to 1,
# restart once, and the login is cleared (every session is invalidated too).
# Then REMOVE it and restart again, or the next boot clears it right back.
# IDLARR_RESET_AUTH=1

# Where nightly database snapshots are written.
IDLARR_BACKUP_DIR=/data/backups

# IDLARR_BACKUP_KEEP has MOVED. Retention is set in Settings -> General and
# stored in trackers.yml. If you already have this variable set, the value is
# copied into your config on the next start and the variable can be deleted;
# it is not read after that. New installs should not set it.
