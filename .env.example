# ============================================================================
# Idlarr — optional environment overrides
# ============================================================================
#
# YOU DO NOT NEED THIS FILE.
#
# On first boot, Idlarr auto-generates a secure token and creates an empty
# tracker config. Everything else — notification URLs, the status URL, and
# the UI login — is configurable from the Settings panel in the web UI.
#
# Env vars exist for two reasons:
#   1. Backward compatibility with existing installs that already have a .env
#   2. Pinning a value outside the app (useful for infrastructure-as-code)
#
# If an env var is set, it OVERRIDES the database value and the UI shows the
# field as locked/read-only.
#
# To use: copy this to .env beside docker-compose.yml and uncomment what you
# want to pin. .env is gitignored.
# ============================================================================

# Shared secret between the service and the userscript.
# Generate:  openssl rand -hex 32
# If left empty, a token is auto-generated on first boot and stored in the DB.
# Find it in Settings > Userscript.
#IDLARR_TOKEN=

# --- notifications -----------------------------------------------------------
# Every alert goes through Apprise, so one setting covers every service.
# Comma-separated. Full URL formats: https://github.com/caronc/apprise/wiki
#
#   ntfy.sh            ntfy://ntfy.sh/your-topic
#   self-hosted ntfy   ntfys://ntfy.example.com/your-topic?token=tk_xxx
#   Pushover           pover://USER_KEY@APP_TOKEN
#   Pushbullet         pbul://ACCESS_TOKEN
#   Discord            discord://WEBHOOK_ID/WEBHOOK_TOKEN
#   Telegram           tgram://BOT_TOKEN/CHAT_ID
#   Gotify             gotify://HOST/TOKEN
#
# If left empty, configure from Settings > Notifications in the UI.
#IDLARR_NOTIFY_URLS=

# Public URL of the status page. Appended to every alert so you can tap
# through to the dashboard. Configurable from Settings > General.
#STATUS_URL=

# Local timezone — drives the daily check and all day counting.
TZ=UTC

# --- signing in --------------------------------------------------------------
# There is deliberately no password setting here. The UI login is configured
# from the status page and stored HASHED in the database.
#
# Forgot the password? Set this to 1, restart once, and the login is cleared.
# Then REMOVE it and restart again, or the next boot clears it right back.
#IDLARR_RESET_AUTH=1

# Nightly database snapshots.
#IDLARR_BACKUP_DIR=/data/backups
#IDLARR_BACKUP_KEEP=14
