# Copy to .env beside docker-compose.yml and fill in. .env is gitignored.

# Shared secret between the service and the userscript.
# Generate:  openssl rand -hex 32
# The SAME value must go into TOKEN in idlarr.user.js, or every ping 401s.
# REQUIRED: the service refuses to start without it.
IDLARR_TOKEN=

# --- notifications -------------------------------------------------------
# Every alert goes through Apprise, so one setting covers every service.
# Comma-separated. Full URL formats: https://github.com/caronc/apprise/wiki
#
#   ntfy.sh            ntfy://ntfy.sh/your-topic
#   self-hosted ntfy   ntfys://ntfy.example.com/your-topic?token=tk_xxx
#   Pushover           pover://USER_KEY@APP_TOKEN
#   Pushbullet         pbul://ACCESS_TOKEN
#   Discord            discord://WEBHOOK_ID/WEBHOOK_TOKEN
#   Telegram           tgram://BOT_TOKEN/CHAT_ID
#   Gotify             gotify://HOST/TOKEN
#
# REQUIRED: with this empty, nothing can ever reach you.
# These strings contain credentials -- that is why they live in .env.
IDLARR_NOTIFY_URLS=

# Public URL of the status page. Used as the ntfy click-through target, so
# tapping a notification opens the dashboard. Leave blank to omit it.
STATUS_URL=

# Local timezone — drives the daily check and all day counting.
TZ=UTC

# UID the container runs as. Must own ./data and ./config on the host.
PUID=1001

# Nightly database snapshots, written during the daily check.
# Set KEEP=0 to disable. 14 dated copies of a ~25KB file costs nothing.
IDLARR_BACKUP_DIR=/data/backups
IDLARR_BACKUP_KEEP=14
